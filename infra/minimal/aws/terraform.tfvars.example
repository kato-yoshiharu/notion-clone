# terraform.tfvars にコピーして値を埋める。terraform.tfvars はgitignore対象。
# DATABASE_URL は infra/minimal/neon のstateから自動で読むため、ここには書かない。

# フロントエンドのオリジン。Cloudflare Workersに割り当てるドメイン。
cors_allowed_origin = "https://example.com"

# Cloudflare経由であることを示す共有シークレット。`openssl rand -hex 32` などで生成する。
origin_shared_secret = "replace-me"
