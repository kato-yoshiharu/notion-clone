{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notion-clone-frontend",

  "account_id": "6a853c25c4f51e69d0859adb71ee401b",
  "main": "worker/index.ts",
  // pnpmで固定しているwranglerが対応する範囲に合わせる。
  "compatibility_date": "2026-05-03",

  // `pnpm build`が書き出すディレクトリ。存在するパスはWorkerより先に解決される。
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },

  // ゾーン単位のWAFレートリミットは独自ドメインが要るため、Worker側で制限する。
  // 制限はCloudflareのロケーションごとで、厳密なカウントではない。
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
